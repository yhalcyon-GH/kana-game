{
  "name": "kana-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser-smoke": "playwright test --config=playwright.config.mjs",
    "verify": "npm run check:project-state && npm run check:prelive && npm run audit:commercial && node --import tsx scripts/convertStrokesvg.ts --check && node scripts/checkAccentData.mjs && npm test && npm run lint && npm run build && git diff --check",
    "check:project-state": "node scripts/checkProjectState.mjs",
    "test:resume-protocol": "node scripts/checkProjectState.mjs --self-test && node scripts/resumeProject.mjs --self-test",
    "resume": "node scripts/resumeProject.mjs",
    "check-voices": "tsx scripts/checkVoiceQuality.ts",
    "voice:analyze": "tsx scripts/voicePipeline/cli.ts --analyze-only",
    "voice:split": "tsx scripts/voicePipeline/cli.ts --split-only",
    "voice:process": "tsx scripts/voicePipeline/cli.ts",
    "check:prelive": "node scripts/checkPreLiveSafety.mjs",
    "audit:commercial": "node scripts/auditCommercialReadiness.mjs",
    "production:preflight": "node scripts/productionReadOnlyPreflight.mjs",
    "production:release-integrity": "node scripts/productionReleaseIntegrity.mjs",
    "production:php-probe": "node scripts/productionPhpVersionProbe.mjs",
    "production:status": "npm run production:php-probe && npm run production:preflight && npm run production:release-integrity",
    "production:cors-probe": "node scripts/productionCorsProbe.mjs"
  },
  "dependencies": {
    "@paddle/paddle-js": "1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@fontsource/klee-one": "^5.3.0",
    "@lumen-labs-dev/whisper-node": "^0.4.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "oxlint": "^1.75.0",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-cacheable-response": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
