# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.tmp-icons
design/images/word-illustrations/pending-review

# Claude Code's per-machine settings (personal permission grants, local
# paths) — .claude/settings.json is the shared/team file and IS meant to be
# committed when it holds project-wide settings worth sharing.
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated by npm run check-voices
voice-check-report.json

# Transient 16kHz-resampled intermediates @lumen-labs-dev/whisper-node
# leaves behind next to each source wav during transcription — not cleaned
# up by the package itself, and not meant to be committed.
public/audio/**/*.wav16k.wav

# scripts/voicePipeline working folders — raw recordings and generated
# splits/reports are review-in-progress content, not shipped assets.
# Promoting an approved batch into public/audio/ is a separate manual step.
/input/
/output/

# Local isolated Git worktrees used for release/debug sessions
/.worktrees/

# Playwright browser-smoke suite (Issue #177) output — reports/traces are
# regenerated per run, never committed.
/test-results/
/playwright-report/
/playwright/.cache/
