# Copy to .env.local for local development. Only feedback/analytics values
# may be set as GitHub Actions repository/environment Variables for production.
# Paddle Sandbox values below are LOCAL DEVELOPMENT ONLY.
# All of these are optional; the app works safely with none of
# them set (Send Feedback stays hidden, analytics stays no-op).
#
# None of these are secrets. A feedback form URL and a Umami website id are
# public client-side values by design — anything under VITE_* is bundled
# into the public JS shipped to every visitor's browser. Never put a
# private/admin API key or token in a VITE_* variable.

# Feedback — see docs/feedback-setup.md for how to obtain a form URL.
# Leave unset to keep the Send Feedback entry hidden.
VITE_FEEDBACK_URL=

# Analytics — see docs/feedback-analytics-provider-decision.md. Only
# 'umami' is currently implemented; any other value (or leaving this blank)
# keeps analytics as a safe no-op.
VITE_ANALYTICS_PROVIDER=

# Required if VITE_ANALYTICS_PROVIDER=umami. Get this from your Umami Cloud
# dashboard after creating a website there (Settings -> Websites -> your
# site -> Tracking code shows the website id).
VITE_UMAMI_WEBSITE_ID=

# Optional: only needed for a self-hosted Umami instance or a non-default
# Cloud region. Defaults to https://cloud.umami.is if left unset.
VITE_UMAMI_HOST_URL=

# Sandbox Checkout PoC only — see docs/paddle-sandbox-checkout.md.
# VITE_* values enter the public browser bundle; use a client-side token only.
# Never use Paddle API secrets/API keys here. Do not commit real tokens/IDs.
# Set only in local .env.local, NEVER production/deployment credentials.
# The /paddle-test route and SDK are excluded from production builds.
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ID=

# Phase 2 webhook/entitlement PoC only — see docs/paddle-webhook-poc.md.
# Base URL of a deployed server/entitlement.php (e.g.
# https://your-domain/api/entitlement.php). Only used by the
# development-only entitlement-check button on /paddle-test; never read in
# production builds. Leave unset to keep that button disabled.
VITE_PADDLE_ENTITLEMENT_API_URL=

# Phase 3A PR C dev-only harness only — see docs/paddle-auth-phase3a-pr-c.md.
# Base URL (no trailing slash) of a deployed server/ directory containing
# the auth/purchase/entitlement endpoints, e.g. https://your-domain/api.
# Only used by the development-only /account-test and /verify routes;
# never read in production builds. Leave unset to keep those routes
# showing a configuration-missing message.
VITE_PADDLE_AUTH_API_BASE_URL=
