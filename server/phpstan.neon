parameters:
    level: 6
    phpVersion: 80400
    paths:
        - src
        - auth
    tmpDir: ../.phpstan-cache

# No Composer/autoloader exists in this repository (server/*.php files use
# explicit `require` instead) -- PHPStan's own reflection over `paths` is
# sufficient since every KanaGame\* class referenced from server/src or
# server/auth also lives under one of those two paths.
#
# There is no phpstan-baseline.neon yet: the Builder sandbox that authored
# this workflow has no network/PHP access to run PHPStan and generate one.
# The first real CI run is authoritative -- if it reports pre-existing
# findings, generate `server/phpstan-baseline.neon` from that run (`analyse
# --generate-baseline`), reference it here with `includes:`, and document
# what was baselined and why in docs/security. Do not blanket-ignore errors.
